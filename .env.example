# Copy to .env and fill in real values: cp .env.example .env

# PostgreSQL connection string
DB_URL=postgres://postgres:postgres@localhost:5432/chirpy?sslmode=disable

# "dev" enables POST /admin/reset (wipes the database). Use anything else in production.
PLATFORM=dev

# Secret used to sign JWT access tokens. Generate one with: openssl rand -base64 64
SECRET=

# API key that the Polka payment provider sends with its webhooks
POLKA_KEY=

# Optional
# ADDR=:8080
# STATIC_DIR=./public
